{
  "name": "vito/plugin-sdk",
  "description": "The Vito Plugin SDK — versioned, typed contracts a plugin builds against.",
  "license": "AGPL-3.0",
  "type": "library",
  "require": {
    "php": "^8.4",
    "illuminate/contracts": "^13.0",
    "illuminate/support": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Vito\\Plugin\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-feat/5.x": "5.x-dev"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
